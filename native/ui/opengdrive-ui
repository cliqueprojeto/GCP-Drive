def startup_error(summary, error, notify=False):
    details = "".join(traceback.format_exception(error)).strip()
    print(f"{NAME}: {summary}\n{details}", file=sys.stderr)
    log = STATE / "interface.log"
    try:
        STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
        fd = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            output.write(f"{summary}\n{details}\n")
        summary += f"\n\nDetalhes em {log}"
    except OSError:
        pass
    if not notify:
        return
    if shutil.which("kdialog"):
        subprocess.Popen(["kdialog", "--title", NAME, "--error", summary])
    elif shutil.which("zenity"):
        subprocess.Popen(["zenity", "--error", "--title", NAME, "--text", summary])


