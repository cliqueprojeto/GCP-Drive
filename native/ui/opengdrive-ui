    row.pack_start(roles, False, False, 0)
    invite = Gtk.Button(label="Enviar")
    invite.get_style_context().add_class("primary")
    row.pack_start(invite, False, False, 0)
    panel.pack_start(row, False, False, 0)
    feedback = label("", "muted")
    panel.pack_start(feedback, False, False, 0)

    panel.pack_start(label("Pessoas com acesso", "share-section"), False, False, 0)
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    scroll.set_min_content_height(130)
    people = vertical(12)
    scroll.add(people)
    panel.pack_start(scroll, True, True, 0)
    panel.pack_start(Gtk.Separator(), False, False, 0)
    panel.pack_start(label("Acesso geral", "share-section"), False, False, 0)
    general_row = horizontal(10)
    general_icon = Gtk.Image.new_from_icon_name("changes-prevent-symbolic", Gtk.IconSize.BUTTON)
    general_row.pack_start(general_icon, False, False, 0)
    general = label("Carregando…")
    general_row.pack_start(general, True, True, 0)
    panel.pack_start(general_row, False, False, 0)

    footer = horizontal(8)
    copied = Gtk.Button(label="Copiar link")
    copied.set_image(Gtk.Image.new_from_icon_name("insert-link-symbolic", Gtk.IconSize.BUTTON))
    copied.set_always_show_image(True)
    copied.get_style_context().add_class("pill")
    footer.pack_start(copied, False, False, 0)
    done = button("Concluído", window.destroy, "primary")
    footer.pack_end(done, False, False, 0)
    footer.pack_end(button("Gerenciar no Drive", lambda: communicate(
        ["context", "web", path], lambda _, err: feedback.set_text(err or "")), "link"), False, False, 0)
    panel.pack_start(footer, False, False, 0)

    open_window = True
    can_share = False
    sending = False

    def closed(*_):
        nonlocal open_window
        open_window = False
    window.connect("destroy", closed)

    def update_invite(*_):
        invite.set_sensitive(can_share and not sending and bool(email.get_text().strip()))

    def load_permissions():
        for child in people.get_children():
            child.destroy()
        people.pack_start(label("Carregando permissões…", "muted"), False, False, 0)
        people.show_all()

        def received(out, error):
            nonlocal can_share
            if not open_window:
                return
            for child in people.get_children():
                child.destroy()
            if error:
                can_share = False
                email.set_sensitive(False)
                grantees.set_sensitive(False)
                roles.set_sensitive(False)
                people.pack_start(label("Não foi possível consultar as permissões.", "muted"), False, False, 0)
                general.set_text("Não foi possível verificar o acesso geral.")
                feedback.set_text(error)
            else:
                data = json.loads(out)
                can_share = data["CanShare"]
                email.set_sensitive(can_share)
                grantees.set_sensitive(can_share)
                roles.set_sensitive(can_share)
                entries = [p for p in data["Permissions"] if not p["Deleted"]]
                visible = [p for p in entries if p["Type"] in ("user", "group")]
                if not visible:
                    people.pack_start(label("Nenhuma pessoa ou grupo aparece nesta conta.", "muted"), False, False, 0)
                for person in visible:
                    person_row = horizontal(12)
                    avatar = Gtk.Image.new_from_icon_name("avatar-default-symbolic", Gtk.IconSize.DIALOG)
                    avatar.get_style_context().add_class("share-avatar")
                    person_row.pack_start(avatar, False, False, 0)
                    details = vertical(2)
                    address = person["EmailAddress"]
                    name = person["DisplayName"] or address or "Conta do Google"
                    details.pack_start(label(name), False, False, 0)
                    if address and address != name:
                        details.pack_start(label(address, "muted"), False, False, 0)
                    person_row.pack_start(details, True, True, 0)
                    person_row.pack_end(label(role_titles.get(person["Role"], "Acesso concedido"), "muted"), False, False, 0)
                    people.pack_start(person_row, False, False, 0)
                anyone = next((p for p in entries if p["Type"] == "anyone"), None)
                domains = [p["Domain"] or p["DisplayName"] for p in entries if p["Type"] == "domain"]
                if anyone:
                    general_icon.set_from_icon_name("web-browser-symbolic", Gtk.IconSize.BUTTON)
                    general.set_text("Público" if anyone["AllowFileDiscovery"] else "Qualquer pessoa com o link")
                elif domains:
                    general_icon.set_from_icon_name("system-users-symbolic", Gtk.IconSize.BUTTON)
                    general.set_text("Acesso na organização " + ", ".join(filter(None, domains)))
                else:
                    general.set_text("Restrito. Só quem tem acesso pode abrir pelo link.")
                if not can_share:
                    feedback.set_text("Sua conta pode consultar as permissões deste item.")
            people.show_all()
            update_invite()
        communicate(["context", "sharing", path], received)

    def send_invite(*_):
        nonlocal sending
        if not invite.get_sensitive():
            return
        sending = True
        feedback.set_text("Enviando convite pelo Google Drive…")
        update_invite()

        def sent(_, error):
            nonlocal sending
            sending = False
            if not open_window:
                return
            feedback.set_text(error or "Convite enviado.")
            if not error:
                email.set_text("")
                load_permissions()
            update_invite()
        communicate(["context", "share", path, email.get_text().strip(),
                     roles.get_active_id(), grantees.get_active_id()], sent)

    def copy_link(*_):
        def received(out, error):
            if not open_window:
                return
            if error:
                feedback.set_text(error)
                return
            copy_drive_link(out.strip())
            copied.set_label("Link copiado")
        communicate(["context", "link", path], received)

    invite.connect("clicked", send_invite)
    email.connect("activate", send_invite)
    email.connect("changed", update_invite)
    copied.connect("clicked", copy_link)
    email.set_sensitive(False)
    grantees.set_sensitive(False)
    roles.set_sensitive(False)
    update_invite()
    window.show_all()
    load_permissions()


def context_path(value):
    if os.path.isabs(value):
        return value
    uri = urlsplit(value)
    if uri.scheme == "file" and uri.netloc in ("", "localhost"):
        path = unquote(uri.path)
        if os.path.isabs(path):
            return path
    if uri.scheme in ("recentlyused", "baloosearch", "filenamesearch"):
        kio = shutil.which("kioclient") or shutil.which("kioclient6") or shutil.which("kioclient5")
        if kio:
            try:
                status = subprocess.run([kio, "stat", value], check=True, capture_output=True,
                                        text=True, timeout=5)
            except (OSError, subprocess.SubprocessError):
                status = None
            if status:
                fields = dict((line[:20].strip(), line[22:]) for line in status.stdout.splitlines() if len(line) > 22)
                if os.path.isabs(fields.get("LOCAL_PATH", "")):
                    return fields["LOCAL_PATH"]
                target = urlsplit(fields.get("TARGET_URL") or fields.get("URL", ""))
                if target.scheme == "file" and target.netloc in ("", "localhost") and target.path.startswith("/"):
                    return unquote(target.path)
    raise ValueError("Abra a pasta na unidade montada e repita a ação.")


def context_action(action, path):
    try:
        path = context_path(path)
    except ValueError as error:
        message(None, NAME, str(error), True)
        return
    loop = GLib.MainLoop()
    window = None

    def finish(out, err):
        if err:
            message(window, NAME, err, True)
        elif action == "link":
            if not copy_drive_link(out.strip()):
                message(window, "Link copiado", "Cole o link no aplicativo de destino.")
        elif action == "gemini":
            message(window, "Gemini no Google Drive", "Abra o painel do Gemini no Drive para Web, se a sua conta tiver acesso.")
        elif action in ("pin", "unpin", "share", "shortcut", "upload"):
            titles = {"pin": "Será mantido off-line", "unpin": "Cópia off-line liberada",
                      "share": "Permissão concedida", "shortcut": "Atalho adicionado", "upload": "Arquivo enviado"}
            message(window, titles[action])
        loop.quit()

    def execute(args):
        communicate(["context", action, path, *args], finish)

    def describe(out, err):
        if err:
            finish(None, err)
            return
        item = json.loads(out)
        if action == "share":
            if item.get("Provider"):
                communicate(["context", "web", path], finish_web_share)
            else:
                share_dialog(path, item, loop)
        elif action == "upload":
            file = choose_file(window, "Enviar arquivo para esta pasta")
            if file:
                execute([file])
            else:
                loop.quit()

    def finish_web_share(_, error):
        if error:
            message(window, "Abrir na nuvem", error, True)
        loop.quit()

    def start():
        if action in ("share", "upload"):
            communicate(["context", "describe", path], describe)
        else:
            execute([])
        return GLib.SOURCE_REMOVE

    GLib.idle_add(start)
    loop.run()


def main():
    screen = Gdk.Screen.get_default()
    if screen is None:
        startup_error("Abra o GCP-Drive dentro da sua sessão gráfica.",
                      RuntimeError("O GTK não encontrou uma tela disponível."))
        return 1
    try:
        provider = Gtk.CssProvider()
        provider.load_from_path(str(Path(__file__).with_name("style.css")))
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    except GLib.Error as error:
        startup_error("Não foi possível carregar o tema da interface.", error)
    if len(sys.argv) == 4 and sys.argv[1] == "--context":
        context_action(sys.argv[2], sys.argv[3])
        return 0
    return Dashboard().run(sys.argv)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as error:
        startup_error("Não foi possível iniciar a interface.", error, notify=True)
        sys.exit(1)
