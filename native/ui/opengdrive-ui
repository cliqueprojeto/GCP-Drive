        search.set_placeholder_text("Pesquisar no Google Drive")
        search.connect("activate", lambda item: self.search(item.get_text()))
        top.pack_start(search, True, True, 0)
        self.pause_button = icon_button("media-playback-pause-symbolic", "Pausar sincronização", self.pause)
        top.pack_start(self.pause_button, False, False, 0)
        settings = Gtk.MenuButton()
        settings.set_image(Gtk.Image.new_from_icon_name("emblem-system-symbolic", Gtk.IconSize.BUTTON))
        settings.set_tooltip_text("Mais opções")
        settings.get_style_context().add_class("toolbar")
        menu = Gtk.Menu()
        for title, page in (
            ("Preferências", "preferences"), ("Espaço usado", "storage"),
            ("Lista de erros", "notifications"), ("Sobre", "about"),
        ):
            entry = Gtk.MenuItem.new_with_label(title)
            entry.connect("activate", lambda _, view=page: self.show(view))
            menu.append(entry)
        support = Gtk.MenuItem.new_with_label("Apoie o projeto")
        support.connect("activate", lambda _: show_support(self.window))
        menu.append(support)
        menu.show_all()
        settings.set_popup(menu)
        top.pack_start(settings, False, False, 0)
        top.pack_start(icon_button("starred-symbolic", "Gemini no Google Drive", self.gemini), False, False, 0)
        self.account_button = button("Contas", lambda: self.show("accounts"), "account", "avatar-default-symbolic")
        top.pack_start(self.account_button, False, False, 0)
        frame.pack_start(top, False, False, 0)

        body = horizontal(18)
        rail = vertical(5)
        rail.set_size_request(224, -1)
        rail.pack_start(button("Abrir pasta do Drive", self.open_mount, "open-drive", "folder-symbolic"), False, False, 0)
        rail.pack_start(Gtk.Box(height_request=13), False, False, 0)
        self.nav = {}
        for page, title, icon in (
            ("home", "Início", "go-home-symbolic"),
            ("activity", "Atividade", "view-refresh-symbolic"),
            ("notifications", "Notificações", "dialog-information-symbolic"),
        ):
            item = button(title, lambda view=page: self.show(view), "nav", icon)
            item.get_child().set_halign(Gtk.Align.START)
            rail.pack_start(item, False, False, 0)
            self.nav[page] = item
        body.pack_start(rail, False, False, 0)
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.surface = vertical(16)
        scroller.add(self.surface)
        body.pack_start(scroller, True, True, 0)
        frame.pack_start(body, True, True, 0)
        self.render()

    def current(self):
        return next((row for row in self.rows if row["ID"] == self.selected), None)

    def refresh(self):
        if self.refreshing:
            return True
        self.refreshing = True

        def update(out, err):
            self.refreshing = False
            old = self.rows
            old_error = self.status_error
            self.status_error = err
            if err and self.background_started and self.daemon is not None and self.daemon.poll() is not None:
                # The engine ended (an update, for example): start it again.
                self.daemon = None
                try:
                    self.start_daemon()
                except OSError as error:
                    startup_error("Não foi possível reiniciar a montagem das unidades.", error)
            if not err:
                self.rows = json.loads(out)
                if not self.current():
                    self.selected = self.rows[0]["ID"] if self.rows else None
                self.update_desktop_integration()
            if not self.window or self.page == "search":
                return
            if self.stable(old) != self.stable(self.rows) or old_error != err:
                self.render()
            else:
                self.update_live()
        communicate(["status"], update)
        return True

    def show(self, page):
        self.page = page
        self.local_status = self.cloud_status = None
        self.render()
        active = self.current()
        if page == "storage" and active:
            self.load_storage(active["ID"])
        if page in ("preferences", "about"):
            self.load_settings()

    def load_storage(self, account):
        def update(field):
            def receive(out, err):
                if self.page != "storage" or self.selected != account:
                    return
                setattr(self, field, json.loads(out) if not err else {"Error": err})
                self.render()
            return receive
        communicate(["storage", account], update("local_status"))
        communicate(["quota", account], update("cloud_status"))

    def selected_account(self, account):
        self.selected = account
        self.render()

    def open_mount(self):
        active = self.current()
        if not active:
            if self.window:
                self.show("accounts")
            else:
                self.activate()
            return
        path = active["MirrorPath"] if active["Mirror"] else active["Path"]
        if not Path(path).is_dir() or not (active["Mounted"] or active["Mirror"]):
            message(self.window, "Unidade indisponível", active["Problem"] or "Aguarde a montagem da conta.")
            return
        open_value(path, self.window)

    def gemini(self):
        active = self.current()
        if active and not active.get("Provider"):
            open_value(google_url("my-drive", active["Email"]), self.window)
            message(self.window, "Gemini no Google Drive", "No Drive para Web, abra o painel do Gemini se o recurso estiver disponível para a sua conta.")
        else:
            self.show("accounts")

    def pause(self):
        active = self.current()
        if not active:
            return
        state = "off" if active["Paused"] else "on"
        self.pause_button.set_sensitive(False)
        def completed(_, error):
            if self.window:
                self.pause_button.set_sensitive(True)
                self.result("Alterar pausa da sincronização", error)
        communicate(["pause", active["ID"], state], completed)

    def result(self, title, err, refresh=True):
        if err:
            message(self.window, title, err, True)
        if refresh:
            self.refresh()

    def registration(self, then=None):
        """Explains the registration with Google and takes the file; then() runs once one is stored."""
        dialog = Gtk.MessageDialog(
            transient_for=self.window, modal=True, message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.NONE, text="Cadastro no Google",
        )
        dialog.format_secondary_text(
            "Para entrar numa Conta do Google, o Google exige um cadastro do aplicativo. "
            "O GCP-Drive não traz um pronto: cada pessoa cria o seu, de graça, em cerca de 10 minutos, uma vez só.\n\n"
            "Siga o passo a passo ilustrado, baixe o arquivo que começa com client_secret e escolha-o aqui. "
            "O arquivo fica só neste computador."
        )
        dialog.add_button("Cancelar", Gtk.ResponseType.CANCEL)
        dialog.add_button("Ver o passo a passo", Gtk.ResponseType.HELP)
        dialog.add_button("Escolher arquivo", Gtk.ResponseType.OK)
        while True:
            answer = dialog.run()
            if answer != Gtk.ResponseType.HELP:
                break
            open_value(GUIDE, self.window)
        dialog.destroy()
        if answer != Gtk.ResponseType.OK:
            return
        path = choose_file(self.window, "Arquivo do cadastro no Google (client_secret….json)")
        if not path:
            return

        def stored(_, error):
            if error:
                message(self.window, "Cadastro no Google", error, True)
            elif then:
                then()
            else:
                message(self.window, "Cadastro no Google", "Cadastro guardado. Agora é só conectar a conta.")

        communicate(["registration", path], stored)

    def add_account(self):
        if self.login_pending:
            return

        def checked(out, _):
            if (out or "").strip() == "ausente":
                self.registration(self.connect_account)
            else:
                self.connect_account()

        communicate(["registration"], checked)

    def connect_account(self):
        if self.login_pending:
            return
        self.login_pending = True
        self.render()

        def completed(_, error):
            self.login_pending = False
            if self.window:
                self.render()
                self.result("Conectar conta do Google", error)

        communicate(["login"], completed)

    def add_account_button(self, icon=None):
        title = "Aguardando autorização no navegador…" if self.login_pending else "Conectar conta do Google"
