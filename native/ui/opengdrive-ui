            spin.set_value(self.settings[key] or 5000)
            spin.set_sensitive(self.settings[key] > 0)
            unit = label("KB/s", "muted")

            def apply(*_, key=key, limited=limited, spin=spin):
                spin.set_sensitive(limited.get_active())
                self.save_settings(**{key: int(spin.get_value()) if limited.get_active() else 0})
            limited.connect("notify::active", apply)
            spin.connect("value-changed", apply)
            row.pack_start(spin, False, False, 0)
            row.pack_start(unit, False, False, 0)
            row.pack_start(limited, False, False, 0)
            speed.pack_start(row, False, False, 0)
        speed.pack_start(label("Desligado = sem limite, usa toda a velocidade disponível.", "muted"), False, False, 0)

        space = self.card("Espaço neste computador", "Os arquivos que você abre ficam guardados aqui para abrir na hora da próxima vez. Os mais antigos saem sozinhos quando o limite é atingido.")
        row = horizontal(12)
