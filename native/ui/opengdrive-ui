        active = self.current()
        if not active:
            self.show("accounts")
            return
        file = choose_file(self.window, "Enviar um arquivo para Meu Drive")
        if file:
            communicate(["upload", active["ID"], file], lambda _, err: self.result("Enviar arquivo", err))

    def toggle_autostart(self, widget):
        try:
            old = AUTOSTART.read_text(encoding="utf-8") if AUTOSTART.exists() else None
            if old is not None and old != DISABLED:
                raise ValueError("Já existe uma configuração de inicialização neste caminho.")
            if widget.get_active():
                if old is not None:
                    AUTOSTART.unlink()
            else:
                AUTOSTART.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                with AUTOSTART.open("x", encoding="utf-8") as file:
                    file.write(DISABLED)
        except (OSError, ValueError) as error:
            message(self.window, "Alterar inicialização", str(error), True)

    def search(self, query):
        active = self.current()
        if not active:
            self.show("accounts")
            return
        query = query.strip()
        if not query:
            return
        self.show("search")
        self.surface.pack_start(label("Pesquisando…", "muted"), False, False, 0)
        self.surface.show_all()

        def receive(out, err):
            if not self.window or self.page != "search":
                return
            self.render()
            card = self.card("Resultados da pesquisa", "“" + query + "” em " + active["Email"])
            if err:
                card.pack_start(label(err), False, False, 0)
            else:
                rows = json.loads(out)
                if not rows:
                    card.pack_start(label("Nenhum resultado nesta conta."), False, False, 0)
                for row in rows:
                    card.pack_start(button(row["Name"], lambda link=row["Link"]: open_value(link, self.window), "link"), False, False, 0)
