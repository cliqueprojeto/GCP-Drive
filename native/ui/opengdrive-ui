    def state_of(self, row):
        if row["Problem"]:
            return "Precisa de atenção", "warn"
        if row["Paused"]:
            return "Pausada", "idle"
        if not row["Mounted"]:
            return "Montando…", "idle"
        if row["Uploads"] or row["Pending"]:
            return "Enviando alterações", "busy"
        if row["Downloads"]:
            return "Baixando", "busy"
        return "Tudo em dia", "ok"

    def problems(self):
        errors = [self.status_error] if self.status_error else []
        for row in self.rows:
            for text in (row["Problem"], row["FileProblem"]):
                if text:
                    errors.append(row["Email"] + " · " + text)
        return errors

    def stable(self, rows):
        """The part of the status that changes the layout; live numbers update in place."""
        volatile = ("Down", "Up", "Downloads", "CacheBytes", "Uploads", "Items")
        return [{k: v for k, v in row.items() if k not in volatile} | {"U": [u["Name"] for u in row.get("Uploads") or []], "B": bool(row["Downloads"])} for row in rows]

    def update_live(self):
        active = self.current()
        if not active or not self.live:
            return
        if "down" in self.live:
            self.live["down"].set_text(size_text(active["Down"]) + "/s")
            self.live["up"].set_text(size_text(active["Up"]) + "/s")
        if "map" in self.live:
            self.live["map"].set_text(self.map_text(active))
        if "cache" in self.live:
            self.live["cache"].set_fraction(min(1.0, active["CacheBytes"] / max(1, active["CacheLimit"])))
            self.live["cache_text"].set_text(size_text(active["CacheBytes"]) + " de " + size_text(active["CacheLimit"]) + " usados para abrir arquivos mais rápido")
        for name, bar in self.live.get("uploads", {}).items():
            for item in active.get("Uploads") or []:
                if item["Name"] == name and item["Total"]:
                    bar.set_fraction(min(1.0, item["Done"] / item["Total"]))

    def map_text(self, active):
        count = f'{active["Items"]:,}'.replace(",", ".")
        if active["Mapped"]:
            return "Mapa de pastas completo · " + count + " itens. As pastas abrem na hora."
        return "Mapeando as pastas da conta… " + count + " itens até agora. Você já pode usar a unidade."

