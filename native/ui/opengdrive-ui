def communicate(args, callback):
    flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE
    try:
        process = Gio.Subprocess.new([CORE, *args], flags)
    except GLib.Error as error:
        callback(None, str(error))
        return

    def completed(proc, result):
        try:
            _, out, err = proc.communicate_utf8_finish(result)
            if proc.get_successful():
                callback(out, None)
            else:
                callback(None, err.strip() or "Não foi possível concluir a operação.")
        except GLib.Error as error:
            callback(None, str(error))

    process.communicate_utf8_async(None, None, completed)


def message(parent, title, detail="", error=False):
    dialog = Gtk.MessageDialog(
        transient_for=parent, modal=True,
        message_type=Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO,
        buttons=Gtk.ButtonsType.OK, text=title,
    )
    if detail:
        dialog.format_secondary_text(detail)
    dialog.run()
    dialog.destroy()


def confirm(parent, title, detail):
    dialog = Gtk.MessageDialog(
        transient_for=parent, modal=True, message_type=Gtk.MessageType.QUESTION,
        buttons=Gtk.ButtonsType.NONE, text=title,
    )
    dialog.format_secondary_text(detail)
    dialog.add_button("Cancelar", Gtk.ResponseType.CANCEL)
    dialog.add_button("Continuar", Gtk.ResponseType.OK)
    dialog.set_default_response(Gtk.ResponseType.CANCEL)
    result = dialog.run() == Gtk.ResponseType.OK
    dialog.destroy()
    return result


def choose_file(parent, title):
    dialog = Gtk.FileChooserNative.new(
        title, parent, Gtk.FileChooserAction.OPEN, "Selecionar", "Cancelar",
    )
    result = dialog.get_filename() if dialog.run() == Gtk.ResponseType.ACCEPT else None
    dialog.destroy()
    return result


def open_value(value, parent=None):
    try:
        uri = Path(value).as_uri() if value.startswith("/") else value
        Gio.AppInfo.launch_default_for_uri(uri, None)
    except (ValueError, GLib.Error) as error:
        message(parent, "Não foi possível abrir", str(error), True)


def google_url(suffix, email):
    from urllib.parse import urlencode
    return "https://drive.google.com/drive/" + suffix + "?" + urlencode({"authuser": email})


def size_text(count):
    value = int(count or 0)
    for unit in ("bytes", "KB", "MB", "GB", "TB"):
        if value < 1024 or unit == "TB":
            return f"{value:,.1f} {unit}" if unit != "bytes" else f"{value} bytes"
        value /= 1024


class Dashboard(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.gcpdrive.Desktop",
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
        )
        self.add_main_option(
            "autostart", 0, GLib.OptionFlags.NONE, GLib.OptionArg.NONE,
            "Iniciar com a sessão", None,
        )
        self.add_main_option(
            "hidden", 0, GLib.OptionFlags.HIDDEN, GLib.OptionArg.NONE,
            "Iniciar na bandeja", None,
        )
        self.window = None
        self.daemon = None
        self.tray = None
        self.tray_held = False
        self.tray_animation = None
        self.tray_frame = 0
        self.places_signature = None
        self.background_started = False
        self.refresh_timer = None
        self.rows = []
        self.selected = None
        self.page = "home"
        self.local_status = None
        self.cloud_status = None
        self.status_error = None
        self.refreshing = False
        self.login_pending = False
        self.settings = None
        self.version = ""
        self.update_asked = False
        self.live = {}

    def do_command_line(self, command):
        options = command.get_options_dict()
        if options.contains("hidden") or (options.contains("autostart") and SETUP_SHOWN.is_file()):
            self.start_background()
            return 0
        return 0 if self.present_panel() else 1

    def start_background(self):
        if self.background_started:
            return GLib.SOURCE_REMOVE
        self.background_started = True
        try:
            self.start_daemon()
        except OSError as error:
            startup_error("Não foi possível iniciar a montagem das unidades.", error)
            self.status_error = "O serviço de montagem não iniciou. Consulte o log da interface."
            self.render()
        try:
            self.create_tray()
            if self.tray and not self.tray_held:
                self.hold()
                self.tray_held = True
        except Exception as error:
            startup_error("Não foi possível registrar o ícone na bandeja.", error)
        self.ensure_refresh()
        return GLib.SOURCE_REMOVE

    def start_daemon(self):
        if self.daemon is None:
            self.daemon = subprocess.Popen(
                [CORE, "daemon"], stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                start_new_session=True,
            )

    def create_tray(self):
        try:
            gi.require_version("AyatanaAppIndicator3", "0.1")
            from gi.repository import AyatanaAppIndicator3 as Indicator
        except (ValueError, ImportError):
            if "x11" in Gdk.Display.get_default().__class__.__name__.lower():
                self.tray = Gtk.StatusIcon.new_from_icon_name(ICON)
                self.tray.set_tooltip_text(NAME)
                self.tray.connect("activate", lambda *_: self.activate())
            return
        self.tray = Indicator.Indicator.new(
            "opengdrive", ICON, Indicator.IndicatorCategory.APPLICATION_STATUS,
        )
        menu = Gtk.Menu()
        for title, action in (("Abrir GCP-Drive", self.activate), ("Abrir pasta do Drive", self.open_mount), ("Sair do painel", self.quit)):
            item = Gtk.MenuItem.new_with_label(title)
            item.connect("activate", lambda _item, fn=action: fn())
            menu.append(item)
        menu.show_all()
        self.tray.set_menu(menu)
        self.tray.set_status(Indicator.IndicatorStatus.ACTIVE)

    def set_tray_icon(self, icon, detail):
        if isinstance(self.tray, Gtk.StatusIcon):
            self.tray.set_from_icon_name(icon)
            self.tray.set_tooltip_text(detail)
        else:
            self.tray.set_icon_full(icon, detail)

    def animate_tray(self):
        self.set_tray_icon(f"{ICON}-sync-{self.tray_frame}", "GCP-Drive · Transferindo arquivos")
        self.tray_frame = (self.tray_frame + 1) % 4
        return GLib.SOURCE_CONTINUE

    def update_desktop_integration(self):
        active = any(item["Status"] == "Em andamento" for row in self.rows for item in row.get("Activity") or [])
        if self.tray and active and self.tray_animation is None:
            self.animate_tray()
            self.tray_animation = GLib.timeout_add(250, self.animate_tray)
        elif self.tray and not active and self.tray_animation is not None:
            GLib.source_remove(self.tray_animation)
            self.tray_animation = None
            self.set_tray_icon(ICON, NAME)
        desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").upper().split(":")
        if "KDE" not in desktop and not os.environ.get("KDE_FULL_SESSION"):
            return
        signature = tuple((row["ID"], row["Path"], row["Email"], row["Mounted"]) for row in self.rows)
        if signature == self.places_signature:
            return
        try:
            update_places(self.rows, DATA)
        except (OSError, ValueError) as error:
            print(f"{NAME}: {error}", file=sys.stderr)
        else:
            self.places_signature = signature

    def ensure_refresh(self):
        if self.refresh_timer is None:
            self.refresh()
            self.refresh_timer = GLib.timeout_add_seconds(2, self.refresh)

    def do_activate(self):
        self.present_panel()

    def present_panel(self):
        if self.window:
            self.window.present()
            return True
        first_launch = not SETUP_SHOWN.is_file()
        if first_launch:
            self.page = "accounts"
        try:
            self.window = Gtk.ApplicationWindow(application=self, title=NAME)
            self.window.get_style_context().add_class("opengdrive")
            self.window.set_default_size(1080, 735)
            self.window.set_size_request(740, 495)
            self.window.set_icon_name(ICON)
            self.window.connect("delete-event", self.close_panel)
            self.create_layout()
            self.window.show_all()
            self.window.present()
        except Exception as error:
            if self.window:
                self.window.destroy()
                self.window = None
            startup_error("Não foi possível abrir a janela de configuração.", error, notify=True)
            return False
        if first_launch:
            try:
                SETUP_SHOWN.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                SETUP_SHOWN.touch(mode=0o600)
            except OSError as error:
                startup_error("Não foi possível registrar a primeira abertura.", error)
        GLib.idle_add(self.start_background)
        self.ensure_refresh()
        self.load_settings()
        return True

    def close_panel(self, *_):
        self.window = None
        return False

    def create_layout(self):
        frame = vertical(16)
        frame.set_border_width(17)
        self.window.add(frame)
        top = horizontal(16)
        brand = horizontal(9)
        brand.set_size_request(224, -1)
