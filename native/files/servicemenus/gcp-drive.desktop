[Desktop Entry]
Type=Service
MimeType=application/octet-stream;
ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Submenu=GCP-Drive
X-KDE-Protocols=file
X-KDE-RequiredNumberOfUrls=1
Icon=gcp-drive
Actions=gemini;web;link;share;shortcut;pin;offline-open;unpin;

[Desktop Action gemini]
Name=Pedir ao Gemini no Drive
Icon=gcp-drive
Exec=/usr/bin/gcp-drive-ui --context gemini %f

[Desktop Action web]
Name=Abrir na nuvem
Icon=gcp-drive
Exec=/usr/bin/gcp-drive-ui --context web %f

[Desktop Action link]
Name=Copiar link da nuvem
Icon=gcp-drive
Exec=/usr/bin/gcp-drive-ui --context link %f

[Desktop Action share]
Name=Compartilhar
Icon=gcp-drive
Exec=/usr/bin/gcp-drive-ui --context share %f

[Desktop Action shortcut]
Name=Adicionar atalho a Meu Drive
Icon=gcp-drive
Exec=/usr/bin/gcp-drive-ui --context shortcut %f

[Desktop Action pin]
Name=Disponibilizar arquivo off-line
Icon=gcp-drive
Exec=/usr/bin/gcp-drive-ui --context pin %f

[Desktop Action offline-open]
Name=Abrir pasta da cópia off-line
Icon=gcp-drive
Exec=/usr/bin/gcp-drive-ui --context offline-open %f

[Desktop Action unpin]
Name=Remover cópia off-line
Icon=gcp-drive
Exec=/usr/bin/gcp-drive-ui --context unpin %f

